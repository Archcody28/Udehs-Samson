PORT=5000
MONGODB_URI=mongodb://localhost:27017/udeh_samson_portfolio
ADMIN_PASSWORD_HASH=replace_with_bcrypt_hash
CLIENT_URL=http://localhost:5173
NODE_ENV=development
# Cloudinary (avatar/CV uploads). Required for POST /api/profile/avatar,
# POST /api/profile/cv, and server/src/migrate-avatar.js.
CLOUDINARY_CLOUD_NAME=replace_with_cloud_name
CLOUDINARY_API_KEY=replace_with_api_key
CLOUDINARY_API_SECRET=replace_with_api_secret
